# Test/dev environment non-secret defaults. Committed.
#
# Layered above env/base.env (this file wins on conflict for ENV=test).
# Production uses env/prod.env (which is NOT in this repo per the security
# policy; values come from the deployment platform).

MODE=dev
COMPOSE_PROFILES=dev,obs
PRISM_WORKER_OTEL_ENABLED=true
API_INTERNAL_PORT=8089
